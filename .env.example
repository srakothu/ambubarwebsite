# Canonical production origin, without a path. Leave blank to use the current
# verified Vercel deployment URL.
NEXT_PUBLIC_SITE_URL=

# Server-only key from https://resend.com/api-keys
RESEND_API_KEY=

# Before a custom domain is verified, Resend's testing sender can deliver only
# to the email address associated with the Resend account.
INQUIRY_FROM_EMAIL="Ambu Bar Website <onboarding@resend.dev>"
INQUIRY_TO_EMAIL="AmbuBarLLC@gmail.com"
